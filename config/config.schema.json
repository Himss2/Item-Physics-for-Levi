{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Levi Item Physics",
  "description": "Java ItemPhysic-style dropped-item physics adapted to Bedrock render models.",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "default": 10,
      "readOnly": true
    },
    "singleModel": {
      "type": "boolean",
      "title": "Single Model",
      "default": false
    },
    "separateDropVisuals": {
      "type": "boolean",
      "title": "Separate Drop Visuals",
      "default": false
    },
    "hideItemShadow": {
      "type": "boolean",
      "title": "Hide Item Shadow",
      "default": true
    }
  }
}
